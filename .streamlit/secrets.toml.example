DATABASE_URL = "postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"
REQUIRE_AUTH = true
ALLOWED_EMAILS = "your-email@example.com"

[auth]
redirect_uri = "https://YOUR-APP-URL/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
